<Window x:Class="DjLoudnessMeter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Loudness Meter Settings"
        Icon="/DjLoudnessMeter;component/Assets/DjLoudnessMeter.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        Width="460"
        Height="410"
        MinWidth="400"
        MinHeight="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        Loaded="OnLoaded">
  <Grid x:Name="MainRoot" Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,12">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="TASKBAR METER" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Overlay settings" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
      </StackPanel>
    </Grid>

    <Border x:Name="StatusPanel" Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="9,6" Margin="0,0,0,12">
      <TextBlock x:Name="StatusText" Text="Selecting an audio device…" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
    </Border>

    <StackPanel x:Name="SettingsPanel" Grid.Row="2">
      <GroupBox Header="Audio source" Padding="10" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ComboBox x:Name="DeviceComboBox" ItemsSource="{Binding Devices}" DisplayMemberPath="FriendlyName" SelectionChanged="OnDeviceSelectionChanged" />
          <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Click="OnRefreshDevicesClick" />
          <TextBlock x:Name="FormatText" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
      </GroupBox>

      <GroupBox Header="Taskbar overlay" Padding="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Side" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
          <ComboBox x:Name="TaskbarSideComboBox" Grid.Column="1" Width="110" HorizontalAlignment="Left" SelectionChanged="OnTaskbarSideSelectionChanged">
            <ComboBoxItem Content="Left" />
            <ComboBoxItem Content="Right" />
          </ComboBox>

          <TextBlock x:Name="MonitorLabel" Grid.Row="1" Text="Monitor" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" />
          <ComboBox x:Name="MonitorComboBox" Grid.Row="1" Grid.Column="1" Width="150" HorizontalAlignment="Left" Margin="0,8,0,0" ItemsSource="{Binding Monitors}" DisplayMemberPath="FriendlyName" SelectionChanged="OnMonitorSelectionChanged" Visibility="Collapsed" />

          <TextBlock Grid.Row="2" Text="Display zero" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,8,0,0" ToolTip="A measured value equal to this dBFS reference is displayed as 0 dB" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="DisplayZeroTextBox" Width="52" HorizontalContentAlignment="Right" LostFocus="OnDisplayZeroLostFocus" KeyDown="OnDisplayZeroKeyDown" ToolTip="Enter a dBFS reference from −30 to 0, for example −9" />
            <TextBlock Text="dBFS" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
          </StackPanel>

          <TextBlock Grid.Row="3" Text="Update rate" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,10,0,0" />
          <Slider x:Name="RefreshIntervalSlider" Grid.Row="3" Grid.Column="1" Minimum="50" Maximum="2000" Ticks="50,125,250,500,750,1000,1250,1500,1750,2000" IsSnapToTickEnabled="True" Margin="0,10,10,0" ValueChanged="OnRefreshIntervalChanged" />
          <TextBlock x:Name="RefreshIntervalValue" Grid.Row="3" Grid.Column="2" Width="58" TextAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0" />

          <TextBlock Grid.Row="4" Text="Values" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,10,0,0" />
          <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="LoudnessValuesCheckBox" Content="Loudness" Checked="OnValueVisibilityChanged" Unchecked="OnValueVisibilityChanged" />
            <CheckBox x:Name="SystemValuesCheckBox" Content="System" Margin="14,0,0,0" Checked="OnValueVisibilityChanged" Unchecked="OnValueVisibilityChanged" />
          </StackPanel>

          <Button Grid.Row="5" Grid.Column="2" Content="Reset meter" Margin="0,10,0,0" Click="OnResetClick" />
        </Grid>
      </GroupBox>
    </StackPanel>

    <Grid x:Name="CompactMeasurements" Grid.Row="0" Grid.RowSpan="3" Background="Transparent" Visibility="Collapsed" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="PeakColumn" Width="*" />
        <ColumnDefinition x:Name="HoldColumn" Width="*" />
        <ColumnDefinition x:Name="MomentaryColumn" Width="*" />
        <ColumnDefinition x:Name="ShortTermColumn" Width="*" />
        <ColumnDefinition x:Name="SeparatorColumn" Width="13" />
        <ColumnDefinition x:Name="TemperatureColumn" Width="0" />
        <ColumnDefinition x:Name="CpuColumn" Width="46" />
        <ColumnDefinition x:Name="MemoryColumn" Width="46" />
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="CompactPeakPanel" Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="CompactPeakLabel" Text="P (500ms)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactPeakValue" Text="−∞" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="16" FontWeight="Normal" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <StackPanel x:Name="CompactHoldPanel" Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="P (5s)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactHoldValue" Text="−∞" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="16" FontWeight="Normal" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <StackPanel x:Name="CompactMomentaryPanel" Grid.Column="2" VerticalAlignment="Center">
        <TextBlock Text="LUFS (0.4s)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactMomentaryValue" Text="−∞" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="16" FontWeight="Normal" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <StackPanel x:Name="CompactShortTermPanel" Grid.Column="3" VerticalAlignment="Center">
        <TextBlock Text="LUFS (3s)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactShortTermValue" Text="−∞" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="16" FontWeight="Normal" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <Border x:Name="CompactSeparator" Grid.Column="4" Width="1" Height="22" Background="#3C464E" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <StackPanel x:Name="CompactTemperaturePanel" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Windows ACPI thermal-zone temperature">
        <TextBlock Text="Temp" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="CompactCpuTemperatureValue" Text="N/A" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Normal" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel x:Name="CompactCpuPanel" Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Total system CPU utilization">
        <TextBlock Text="CPU" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="CompactCpuUsageValue" Text="N/A" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Normal" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel x:Name="CompactMemoryPanel" Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Physical memory utilization">
        <TextBlock Text="RAM" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="CompactMemoryUsageValue" Text="N/A" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" FontWeight="Normal" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
