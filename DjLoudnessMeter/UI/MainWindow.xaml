<Window x:Class="DjLoudnessMeter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DjLoudnessMeter.UI"
        Title="DJ Loudness Meter"
        Icon="/DjLoudnessMeter;component/Assets/DjLoudnessMeter.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        Width="440"
        Height="520"
        MinWidth="340"
        MinHeight="330"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        Loaded="OnLoaded"
        MouseDoubleClick="OnWindowMouseDoubleClick"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
  <Window.Resources>
    <Style x:Key="MeasurementLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MeasurementValueStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style x:Key="PriorityMeasurementLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MeasurementLabelStyle}">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="PriorityMeasurementValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MeasurementValueStyle}">
      <Setter Property="FontSize" Value="27" />
    </Style>
  </Window.Resources>
  <Grid x:Name="MainRoot" Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="MasterLabel" Text="MASTER" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Border x:Name="ClipIndicator" Grid.Column="1" Background="#3A2527" CornerRadius="3" Padding="8,3" Margin="0,0,12,0" Visibility="Hidden">
        <TextBlock Text="CLIP" Foreground="{StaticResource ClipBrush}" FontWeight="Bold" />
      </Border>
      <CheckBox x:Name="AlwaysOnTopCheckBox" Grid.Column="2" Content="Always on top" VerticalAlignment="Center" Checked="OnAlwaysOnTopChanged" Unchecked="OnAlwaysOnTopChanged" />
      <Button x:Name="CompactButton" Grid.Column="3" Content="Compact" Margin="12,0,0,0" Click="OnCompactClick" />
      <Button x:Name="TaskbarButton" Grid.Column="4" Content="Taskbar" Margin="8,0,0,0" Click="OnTaskbarClick" ToolTip="Place the meter over the bottom-left taskbar area" />
    </Grid>

    <Border x:Name="StatusPanel" Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="9,6" Margin="0,0,0,12">
      <TextBlock x:Name="StatusText" Text="Selecting an audio device…" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
    </Border>

    <ui:LevelMeterControl x:Name="MasterMeter" Grid.Row="2" Margin="0,0,0,10" />

    <Grid x:Name="NormalMeasurements" Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" MinWidth="155" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="PEAK (500 ms)" Style="{StaticResource MeasurementLabelStyle}" />
      <TextBlock x:Name="PeakValue" Grid.Row="0" Grid.Column="1" Text="−∞" Style="{StaticResource MeasurementValueStyle}" />
      <TextBlock Grid.Row="1" Text="PEAK HOLD (5 s)" Style="{StaticResource MeasurementLabelStyle}" />
      <TextBlock x:Name="HoldValue" Grid.Row="1" Grid.Column="1" Text="−∞" Style="{StaticResource MeasurementValueStyle}" />
      <TextBlock Grid.Row="2" Text="LUFS-M (0.4 s)" Style="{StaticResource MeasurementLabelStyle}" />
      <TextBlock x:Name="MomentaryValue" Grid.Row="2" Grid.Column="1" Text="−∞" Style="{StaticResource MeasurementValueStyle}" />
      <TextBlock Grid.Row="3" Text="LUFS-S (3 s)" Style="{StaticResource PriorityMeasurementLabelStyle}" />
      <TextBlock x:Name="ShortTermValue" Grid.Row="3" Grid.Column="1" Text="−∞" Style="{StaticResource PriorityMeasurementValueStyle}" />
      <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SYSTEM" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" />
        <Border Grid.Column="1" Height="1" Background="#3C464E" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Grid.Row="5" Text="CPU TEMP" Style="{StaticResource MeasurementLabelStyle}" ToolTip="Windows ACPI thermal-zone temperature" />
      <TextBlock x:Name="CpuTemperatureValue" Grid.Row="5" Grid.Column="1" Text="N/A" Style="{StaticResource MeasurementValueStyle}" ToolTip="Windows ACPI thermal-zone temperature" />
      <TextBlock Grid.Row="6" Text="CPU USAGE" Style="{StaticResource MeasurementLabelStyle}" />
      <TextBlock x:Name="CpuUsageValue" Grid.Row="6" Grid.Column="1" Text="N/A" Style="{StaticResource MeasurementValueStyle}" ToolTip="Total system CPU utilization" />
      <TextBlock Grid.Row="7" Text="RAM USAGE" Style="{StaticResource MeasurementLabelStyle}" />
      <TextBlock x:Name="MemoryUsageValue" Grid.Row="7" Grid.Column="1" Text="N/A" Style="{StaticResource MeasurementValueStyle}" ToolTip="Physical memory utilization" />
    </Grid>

    <Grid x:Name="CompactMeasurements" Grid.Row="0" Grid.RowSpan="6" Visibility="Collapsed" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="13" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="CompactPeakPanel" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <TextBlock Text="P (500ms)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactPeakValue" Text="−∞" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <StackPanel x:Name="CompactHoldPanel" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <TextBlock Text="P (5s)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactHoldValue" Text="−∞" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <StackPanel x:Name="CompactMomentaryPanel" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <TextBlock Text="LUFS (0.4s)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactMomentaryValue" Text="−∞" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <StackPanel x:Name="CompactShortTermPanel" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <TextBlock Text="LUFS (3s)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
        <TextBlock x:Name="CompactShortTermValue" Text="−∞" FontFamily="Consolas" FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Right" Margin="0,0,5,0" />
      </StackPanel>
      <Border Grid.Column="4" Width="1" Height="22" Background="#3C464E" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <StackPanel Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Windows ACPI thermal-zone temperature">
        <TextBlock Text="Temp" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="CompactCpuTemperatureValue" Text="N/A" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Total system CPU utilization">
        <TextBlock Text="CPU" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="CompactCpuUsageValue" Text="N/A" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Physical memory utilization">
        <TextBlock Text="RAM" Foreground="{StaticResource SecondaryTextBrush}" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="CompactMemoryUsageValue" Text="N/A" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid x:Name="DevicePanel" Grid.Row="4" Margin="0,0,0,9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="DeviceComboBox" ItemsSource="{Binding Devices}" DisplayMemberPath="FriendlyName" SelectionChanged="OnDeviceSelectionChanged" />
      <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Click="OnRefreshDevicesClick" />
    </Grid>

    <Grid x:Name="FooterPanel" Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="FormatText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="Zero at" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="A measured value equal to this dBFS reference is displayed as 0 dB" />
      <TextBox x:Name="DisplayZeroTextBox" Grid.Column="2" Width="48" Margin="6,0,0,0" HorizontalContentAlignment="Right" LostFocus="OnDisplayZeroLostFocus" KeyDown="OnDisplayZeroKeyDown" ToolTip="Enter a dBFS reference from −30 to 0, for example −9" />
      <TextBlock Grid.Column="3" Text="dBFS" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="4,0,8,0" />
      <Button Grid.Column="4" Content="Reset" Click="OnResetClick" />
    </Grid>
  </Grid>
</Window>
