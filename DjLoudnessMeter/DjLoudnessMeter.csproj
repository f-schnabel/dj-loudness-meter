<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DjLoudnessMeter.ico</ApplicationIcon>
    <AssemblyName>DjLoudnessMeter</AssemblyName>
    <RootNamespace>DjLoudnessMeter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DjLoudnessMeter.ico" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.0-preview.19" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Native/runtimes/win-x64/native/ebur128.dll')">
    <Content Include="Native/runtimes/win-x64/native/ebur128.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>ebur128.dll</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
