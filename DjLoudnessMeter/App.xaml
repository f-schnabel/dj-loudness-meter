<Application x:Class="DjLoudnessMeter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111417" />
    <SolidColorBrush x:Key="PanelBrush" Color="#191E22" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F5F6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8F9AA3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#58D68D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F6C344" />
    <SolidColorBrush x:Key="ClipBrush" Color="#FF5A5F" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="#2A3137" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="#3C464E" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Background" Value="#20262B" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="#3C464E" />
      <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
  </Application.Resources>
</Application>
